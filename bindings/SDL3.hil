    DisplayMode = RECORD Display: DisplayID; Format: CARDINAL32; W,H: INTEGER32; PixelDensity, RefreshRate: REAL32; RefreshRateNumerator, RefreshRateDenominator: INTEGER32; Internal: ADDRESS; END;
    AudioSpec = RECORD Format: CARDINAL32; Channels: INTEGER32; Freq: INTEGER32; END;
