MODULE BZip2;
(* First-party bzip2 C ABI binding. *)
EXPORT BZFile, BZ_OK, BZ_RUN_OK, BZ_FLUSH_OK, BZ_FINISH_OK, BZ_STREAM_END, BZ_SEQUENCE_ERROR, BZ_PARAM_ERROR, BZ_MEM_ERROR, BZ_DATA_ERROR, BZ_DATA_ERROR_MAGIC, BZ_IO_ERROR, BZ_UNEXPECTED_EOF, BZ_OUTBUFF_FULL, BZ2_bzlibVersion, BZ2_bzBuffToBuffCompress;
EXPORT BZ2_bzBuffToBuffDecompress, BZ2_bzopen, BZ2_bzdopen, BZ2_bzread, BZ2_bzwrite, BZ2_bzflush, BZ2_bzclose;

FOREIGN "C" LIBRARY "bz2";

TYPE
    BZFile = ADDRESS;

CONST
    BZ_OK = 0;
    BZ_RUN_OK = 1;
    BZ_FLUSH_OK = 2;
    BZ_FINISH_OK = 3;
    BZ_STREAM_END = 4;
    BZ_SEQUENCE_ERROR = -1;
    BZ_PARAM_ERROR = -2;
    BZ_MEM_ERROR = -3;
    BZ_DATA_ERROR = -4;
    BZ_DATA_ERROR_MAGIC = -5;
    BZ_IO_ERROR = -6;
    BZ_UNEXPECTED_EOF = -7;
    BZ_OUTBUFF_FULL = -8;

FOREIGN "C" PROCEDURE BZ2_bzlibVersion(): CSTRING;
FOREIGN "C" PROCEDURE BZ2_bzBuffToBuffCompress(Dest: CSTRING; DestLen: POINTER TO CARDINAL32; Source: CSTRING; SourceLen: CARDINAL32; BlockSize100k, Verbosity, WorkFactor: INTEGER32): INTEGER32;
FOREIGN "C" PROCEDURE BZ2_bzBuffToBuffDecompress(Dest: CSTRING; DestLen: POINTER TO CARDINAL32; Source: CSTRING; SourceLen: CARDINAL32; Small, Verbosity: INTEGER32): INTEGER32;
FOREIGN "C" PROCEDURE BZ2_bzopen(Path, Mode: CSTRING): BZFile;
FOREIGN "C" PROCEDURE BZ2_bzdopen(Fd: INTEGER32; Mode: CSTRING): BZFile;
FOREIGN "C" PROCEDURE BZ2_bzread(File: BZFile; Buf: ADDRESS; Len: INTEGER32): INTEGER32;
FOREIGN "C" PROCEDURE BZ2_bzwrite(File: BZFile; Buf: ADDRESS; Len: INTEGER32): INTEGER32;
FOREIGN "C" PROCEDURE BZ2_bzflush(File: BZFile): INTEGER32;
FOREIGN "C" PROCEDURE BZ2_bzclose(File: BZFile);

END BZip2.
