MODULE LibArchive;
(* First-party libarchive C ABI binding. *)
EXPORT Archive, ArchiveEntry, ARCHIVE_OK, ARCHIVE_EOF, ARCHIVE_RETRY, ARCHIVE_WARN, ARCHIVE_FAILED, ARCHIVE_FATAL, archive_version_number, archive_version_string, archive_read_new, archive_read_support_filter_all, archive_read_support_filter_gzip, archive_read_support_filter_bzip2, archive_read_support_filter_xz, archive_read_support_format_all;
EXPORT archive_read_support_format_tar, archive_read_support_format_zip, archive_read_open_filename, archive_read_open_memory, archive_read_next_header, archive_read_data, archive_read_data_skip, archive_read_close, archive_read_free, archive_error_string, archive_errno, archive_entry_pathname, archive_entry_size, archive_entry_filetype, archive_entry_perm, archive_write_new;
EXPORT archive_write_set_format_pax_restricted, archive_write_set_format_zip, archive_write_add_filter_gzip, archive_write_open_filename, archive_write_header, archive_write_data, archive_write_close, archive_write_free, archive_entry_new, archive_entry_free, archive_entry_set_pathname, archive_entry_set_size, archive_entry_set_filetype, archive_entry_set_perm;

FOREIGN "C" LIBRARY "archive";

TYPE
    Archive = ADDRESS;
    ArchiveEntry = ADDRESS;

CONST
    ARCHIVE_OK = 0;
    ARCHIVE_EOF = 1;
    ARCHIVE_RETRY = -10;
    ARCHIVE_WARN = -20;
    ARCHIVE_FAILED = -25;
    ARCHIVE_FATAL = -30;

FOREIGN "C" PROCEDURE archive_version_number(): INTEGER32;
FOREIGN "C" PROCEDURE archive_version_string(): CSTRING;
FOREIGN "C" PROCEDURE archive_read_new(): Archive;
FOREIGN "C" PROCEDURE archive_read_support_filter_all(A: Archive): INTEGER32;
FOREIGN "C" PROCEDURE archive_read_support_filter_gzip(A: Archive): INTEGER32;
FOREIGN "C" PROCEDURE archive_read_support_filter_bzip2(A: Archive): INTEGER32;
FOREIGN "C" PROCEDURE archive_read_support_filter_xz(A: Archive): INTEGER32;
FOREIGN "C" PROCEDURE archive_read_support_format_all(A: Archive): INTEGER32;
FOREIGN "C" PROCEDURE archive_read_support_format_tar(A: Archive): INTEGER32;
FOREIGN "C" PROCEDURE archive_read_support_format_zip(A: Archive): INTEGER32;
FOREIGN "C" PROCEDURE archive_read_open_filename(A: Archive; Filename: CSTRING; BlockSize: SIZE): INTEGER32;
FOREIGN "C" PROCEDURE archive_read_open_memory(A: Archive; Buffer: ADDRESS; Size: SIZE): INTEGER32;
FOREIGN "C" PROCEDURE archive_read_next_header(A: Archive; Entry: POINTER TO ArchiveEntry): INTEGER32;
FOREIGN "C" PROCEDURE archive_read_data(A: Archive; Buffer: ADDRESS; Size: SIZE): INTEGER64;
FOREIGN "C" PROCEDURE archive_read_data_skip(A: Archive): INTEGER32;
FOREIGN "C" PROCEDURE archive_read_close(A: Archive): INTEGER32;
FOREIGN "C" PROCEDURE archive_read_free(A: Archive): INTEGER32;
FOREIGN "C" PROCEDURE archive_error_string(A: Archive): CSTRING;
FOREIGN "C" PROCEDURE archive_errno(A: Archive): INTEGER32;
FOREIGN "C" PROCEDURE archive_entry_pathname(Entry: ArchiveEntry): CSTRING;
FOREIGN "C" PROCEDURE archive_entry_size(Entry: ArchiveEntry): INTEGER64;
FOREIGN "C" PROCEDURE archive_entry_filetype(Entry: ArchiveEntry): CARDINAL32;
FOREIGN "C" PROCEDURE archive_entry_perm(Entry: ArchiveEntry): CARDINAL32;
FOREIGN "C" PROCEDURE archive_write_new(): Archive;
FOREIGN "C" PROCEDURE archive_write_set_format_pax_restricted(A: Archive): INTEGER32;
FOREIGN "C" PROCEDURE archive_write_set_format_zip(A: Archive): INTEGER32;
FOREIGN "C" PROCEDURE archive_write_add_filter_gzip(A: Archive): INTEGER32;
FOREIGN "C" PROCEDURE archive_write_open_filename(A: Archive; Filename: CSTRING): INTEGER32;
FOREIGN "C" PROCEDURE archive_write_header(A: Archive; Entry: ArchiveEntry): INTEGER32;
FOREIGN "C" PROCEDURE archive_write_data(A: Archive; Buffer: ADDRESS; Size: SIZE): INTEGER64;
FOREIGN "C" PROCEDURE archive_write_close(A: Archive): INTEGER32;
FOREIGN "C" PROCEDURE archive_write_free(A: Archive): INTEGER32;
FOREIGN "C" PROCEDURE archive_entry_new(): ArchiveEntry;
FOREIGN "C" PROCEDURE archive_entry_free(Entry: ArchiveEntry);
FOREIGN "C" PROCEDURE archive_entry_set_pathname(Entry: ArchiveEntry; Path: CSTRING);
FOREIGN "C" PROCEDURE archive_entry_set_size(Entry: ArchiveEntry; Size: INTEGER64);
FOREIGN "C" PROCEDURE archive_entry_set_filetype(Entry: ArchiveEntry; FileType: CARDINAL32);
FOREIGN "C" PROCEDURE archive_entry_set_perm(Entry: ArchiveEntry; Perm: CARDINAL32);

END LibArchive.
