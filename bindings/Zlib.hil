MODULE Zlib;
(* First-party zlib C ABI binding. *)
EXPORT ZStream, GzFile, Z_NO_FLUSH, Z_PARTIAL_FLUSH, Z_SYNC_FLUSH, Z_FULL_FLUSH, Z_FINISH, Z_BLOCK, Z_TREES, Z_OK, Z_STREAM_END, Z_NEED_DICT, Z_ERRNO, Z_STREAM_ERROR, Z_DATA_ERROR, Z_MEM_ERROR;
EXPORT Z_BUF_ERROR, Z_VERSION_ERROR, Z_DEFAULT_COMPRESSION, Z_BEST_SPEED, Z_BEST_COMPRESSION, Z_DEFLATED, zlibVersion, deflateInit_, deflate, deflateEnd, inflateInit_, inflate, inflateEnd, compress, compress2, compressBound;
EXPORT uncompress, crc32, crc32_z, adler32, gzopen, gzdopen, gzread, gzwrite, gzclose, gzflush, gzseek, gztell, gzeof, gzerror;

FOREIGN "C" LIBRARY "z";

TYPE
    ZStream = ADDRESS;
    GzFile = ADDRESS;

CONST
    Z_NO_FLUSH = 0;
    Z_PARTIAL_FLUSH = 1;
    Z_SYNC_FLUSH = 2;
    Z_FULL_FLUSH = 3;
    Z_FINISH = 4;
    Z_BLOCK = 5;
    Z_TREES = 6;
    Z_OK = 0;
    Z_STREAM_END = 1;
    Z_NEED_DICT = 2;
    Z_ERRNO = -1;
    Z_STREAM_ERROR = -2;
    Z_DATA_ERROR = -3;
    Z_MEM_ERROR = -4;
    Z_BUF_ERROR = -5;
    Z_VERSION_ERROR = -6;
    Z_DEFAULT_COMPRESSION = -1;
    Z_BEST_SPEED = 1;
    Z_BEST_COMPRESSION = 9;
    Z_DEFLATED = 8;

FOREIGN "C" PROCEDURE zlibVersion(): CSTRING;
FOREIGN "C" PROCEDURE deflateInit_(Strm: ZStream; Level: INTEGER32; Version: CSTRING; StreamSize: INTEGER32): INTEGER32;
FOREIGN "C" PROCEDURE deflate(Strm: ZStream; Flush: INTEGER32): INTEGER32;
FOREIGN "C" PROCEDURE deflateEnd(Strm: ZStream): INTEGER32;
FOREIGN "C" PROCEDURE inflateInit_(Strm: ZStream; Version: CSTRING; StreamSize: INTEGER32): INTEGER32;
FOREIGN "C" PROCEDURE inflate(Strm: ZStream; Flush: INTEGER32): INTEGER32;
FOREIGN "C" PROCEDURE inflateEnd(Strm: ZStream): INTEGER32;
FOREIGN "C" PROCEDURE compress(Dest: POINTER TO BYTE; DestLen: POINTER TO CARDINAL64; Source: POINTER TO BYTE; SourceLen: CARDINAL64): INTEGER32;
FOREIGN "C" PROCEDURE compress2(Dest: POINTER TO BYTE; DestLen: POINTER TO CARDINAL64; Source: POINTER TO BYTE; SourceLen: CARDINAL64; Level: INTEGER32): INTEGER32;
FOREIGN "C" PROCEDURE compressBound(SourceLen: CARDINAL64): CARDINAL64;
FOREIGN "C" PROCEDURE uncompress(Dest: POINTER TO BYTE; DestLen: POINTER TO CARDINAL64; Source: POINTER TO BYTE; SourceLen: CARDINAL64): INTEGER32;
FOREIGN "C" PROCEDURE crc32(Crc: CARDINAL64; Buf: POINTER TO BYTE; Len: CARDINAL32): CARDINAL64;
FOREIGN "C" PROCEDURE crc32_z(Crc: CARDINAL64; Buf: POINTER TO BYTE; Len: SIZE): CARDINAL64;
FOREIGN "C" PROCEDURE adler32(Adler: CARDINAL64; Buf: POINTER TO BYTE; Len: CARDINAL32): CARDINAL64;
FOREIGN "C" PROCEDURE gzopen(Path, Mode: CSTRING): GzFile;
FOREIGN "C" PROCEDURE gzdopen(Fd: INTEGER32; Mode: CSTRING): GzFile;
FOREIGN "C" PROCEDURE gzread(File: GzFile; Buf: ADDRESS; Len: CARDINAL32): INTEGER32;
FOREIGN "C" PROCEDURE gzwrite(File: GzFile; Buf: ADDRESS; Len: CARDINAL32): INTEGER32;
FOREIGN "C" PROCEDURE gzclose(File: GzFile): INTEGER32;
FOREIGN "C" PROCEDURE gzflush(File: GzFile; Flush: INTEGER32): INTEGER32;
FOREIGN "C" PROCEDURE gzseek(File: GzFile; Offset: INTEGER64; Whence: INTEGER32): INTEGER64;
FOREIGN "C" PROCEDURE gztell(File: GzFile): INTEGER64;
FOREIGN "C" PROCEDURE gzeof(File: GzFile): INTEGER32;
FOREIGN "C" PROCEDURE gzerror(File: GzFile; ErrNum: POINTER TO INTEGER32): CSTRING;

END Zlib.
