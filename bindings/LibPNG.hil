MODULE LibPNG;
(* First-party libpng C ABI binding. *)
EXPORT PngStruct, PngInfo, png_access_version_number, png_get_libpng_ver, png_create_read_struct, png_create_write_struct, png_create_info_struct, png_destroy_read_struct, png_destroy_write_struct, png_init_io, png_set_read_fn, png_set_write_fn, png_read_info, png_read_image, png_read_end, png_write_info;
EXPORT png_write_image, png_write_end, png_get_image_width, png_get_image_height, png_get_color_type, png_get_bit_depth, png_get_rowbytes, png_set_IHDR;

FOREIGN "C" LIBRARY "png";

TYPE
    PngStruct = ADDRESS;
    PngInfo = ADDRESS;

FOREIGN "C" PROCEDURE png_access_version_number(): CARDINAL32;
FOREIGN "C" PROCEDURE png_get_libpng_ver(PngPtr: PngStruct): CSTRING;
FOREIGN "C" PROCEDURE png_create_read_struct(UserPngVer: CSTRING; ErrorPtr, ErrorFn, WarnFn: ADDRESS): PngStruct;
FOREIGN "C" PROCEDURE png_create_write_struct(UserPngVer: CSTRING; ErrorPtr, ErrorFn, WarnFn: ADDRESS): PngStruct;
FOREIGN "C" PROCEDURE png_create_info_struct(PngPtr: PngStruct): PngInfo;
FOREIGN "C" PROCEDURE png_destroy_read_struct(PngPtrPtr, InfoPtrPtr, EndInfoPtrPtr: ADDRESS);
FOREIGN "C" PROCEDURE png_destroy_write_struct(PngPtrPtr, InfoPtrPtr: ADDRESS);
FOREIGN "C" PROCEDURE png_init_io(PngPtr: PngStruct; File: ADDRESS);
FOREIGN "C" PROCEDURE png_set_read_fn(PngPtr: PngStruct; IoPtr, ReadFn: ADDRESS);
FOREIGN "C" PROCEDURE png_set_write_fn(PngPtr: PngStruct; IoPtr, WriteFn, FlushFn: ADDRESS);
FOREIGN "C" PROCEDURE png_read_info(PngPtr: PngStruct; InfoPtr: PngInfo);
FOREIGN "C" PROCEDURE png_read_image(PngPtr: PngStruct; Rows: ADDRESS);
FOREIGN "C" PROCEDURE png_read_end(PngPtr: PngStruct; InfoPtr: PngInfo);
FOREIGN "C" PROCEDURE png_write_info(PngPtr: PngStruct; InfoPtr: PngInfo);
FOREIGN "C" PROCEDURE png_write_image(PngPtr: PngStruct; Rows: ADDRESS);
FOREIGN "C" PROCEDURE png_write_end(PngPtr: PngStruct; InfoPtr: PngInfo);
FOREIGN "C" PROCEDURE png_get_image_width(PngPtr: PngStruct; InfoPtr: PngInfo): CARDINAL32;
FOREIGN "C" PROCEDURE png_get_image_height(PngPtr: PngStruct; InfoPtr: PngInfo): CARDINAL32;
FOREIGN "C" PROCEDURE png_get_color_type(PngPtr: PngStruct; InfoPtr: PngInfo): BYTE;
FOREIGN "C" PROCEDURE png_get_bit_depth(PngPtr: PngStruct; InfoPtr: PngInfo): BYTE;
FOREIGN "C" PROCEDURE png_get_rowbytes(PngPtr: PngStruct; InfoPtr: PngInfo): SIZE;
FOREIGN "C" PROCEDURE png_set_IHDR(PngPtr: PngStruct; InfoPtr: PngInfo; Width,Height: CARDINAL32; BitDepth,ColorType,Interlace,Compression,Filter: INTEGER32);

END LibPNG.
