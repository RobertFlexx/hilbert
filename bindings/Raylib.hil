FOREIGN "C" LIBRARY "raylib";

TYPE
    Vector2 = RECORD X, Y: REAL32; END;
    Vector3 = RECORD X, Y, Z: REAL32; END;
    Vector4 = RECORD X, Y, Z, W: REAL32; END;
    Quaternion = Vector4;
    Matrix = RECORD
        M0, M4, M8, M12: REAL32;
        M1, M5, M9, M13: REAL32;
        M2, M6, M10, M14: REAL32;
        M3, M7, M11, M15: REAL32;
    END;
    Color = RECORD R, G, B, A: BYTE; END;
    Rectangle = RECORD X, Y, Width, Height: REAL32; END;
    Image = RECORD Data: ADDRESS; Width, Height, Mipmaps, Format: INTEGER32; END;
    Texture = RECORD Id: CARDINAL32; Width, Height, Mipmaps, Format: INTEGER32; END;
    Texture2D = Texture;
    TextureCubemap = Texture;
    RenderTexture = RECORD Id: CARDINAL32; TextureData, Depth: Texture; END;
    RenderTexture2D = RenderTexture;
    NPatchInfo = RECORD Source: Rectangle; Left, Top, Right, Bottom, Layout: INTEGER32; END;
    GlyphInfo = RECORD Value, OffsetX, OffsetY, AdvanceX: INTEGER32; ImageData: Image; END;
    Font = RECORD BaseSize, GlyphCount, GlyphPadding: INTEGER32; TextureData: Texture2D; Recs, Glyphs: ADDRESS; END;
    Camera3D = RECORD Position, Target, Up: Vector3; Fovy: REAL32; Projection: INTEGER32; END;
    Camera = Camera3D;
    Camera2D = RECORD Offset, Target: Vector2; Rotation, Zoom: REAL32; END;
    Mesh = RECORD
        VertexCount, TriangleCount: INTEGER32;
        Vertices, Texcoords, Texcoords2, Normals, Tangents: POINTER TO REAL32;
        Colors: POINTER TO BYTE;
        Indices: POINTER TO CARDINAL16;
        BoneCount: INTEGER32;
        BoneIndices: POINTER TO BYTE;
        BoneWeights, AnimVertices, AnimNormals: POINTER TO REAL32;
        VaoId: CARDINAL32;
        VboId: POINTER TO CARDINAL32;
    END;
    Shader = RECORD Id: CARDINAL32; Locs: POINTER TO INTEGER32; END;
    MaterialMap = RECORD TextureData: Texture2D; ColorData: Color; Value: REAL32; END;
    Material = RECORD ShaderData: Shader; Maps: POINTER TO MaterialMap; Params: ARRAY 4 OF REAL32; END;
    Transform = RECORD Translation: Vector3; Rotation: Quaternion; Scale: Vector3; END;
    BoneInfo = RECORD Name: ARRAY 32 OF CHAR; Parent: INTEGER32; END;
    ModelSkeleton = RECORD BoneCount: INTEGER32; Bones: POINTER TO BoneInfo; BindPose: POINTER TO Transform; END;
    Model = RECORD TransformData: Matrix; MeshCount, MaterialCount: INTEGER32; Meshes: POINTER TO Mesh; Materials: POINTER TO Material; MeshMaterial: POINTER TO INTEGER32; Skeleton: ModelSkeleton; CurrentPose: POINTER TO Transform; BoneMatrices: POINTER TO Matrix; END;
    ModelAnimation = RECORD Name: ARRAY 32 OF CHAR; BoneCount, KeyframeCount: INTEGER32; KeyframePoses: ADDRESS; END;
    Ray = RECORD Position, Direction: Vector3; END;
    RayCollision = RECORD Hit: BOOLEAN; Distance: REAL32; Point, Normal: Vector3; END;
    BoundingBox = RECORD Min, Max: Vector3; END;
    Wave = RECORD FrameCount, SampleRate, SampleSize, Channels: CARDINAL32; Data: ADDRESS; END;
    AudioStream = RECORD Buffer, Processor: ADDRESS; SampleRate, SampleSize, Channels: CARDINAL32; END;
    Sound = RECORD Stream: AudioStream; FrameCount: CARDINAL32; END;
    Music = RECORD Stream: AudioStream; FrameCount: CARDINAL32; Looping: BOOLEAN; CtxType: INTEGER32; CtxData: ADDRESS; END;
    VrDeviceInfo = RECORD HResolution, VResolution: INTEGER32; HScreenSize, VScreenSize, EyeToScreenDistance, LensSeparationDistance, InterpupillaryDistance: REAL32; LensDistortionValues, ChromaAbCorrection: ARRAY 4 OF REAL32; END;
    VrStereoConfig = RECORD Projection, ViewOffset: ARRAY 2 OF Matrix; LeftLensCenter, RightLensCenter, LeftScreenCenter, RightScreenCenter, Scale, ScaleIn: ARRAY 2 OF REAL32; END;
    FilePathList = RECORD Count: CARDINAL32; Paths: POINTER TO CSTRING; END;
    AutomationEvent = RECORD Frame, EventType: CARDINAL32; Params: ARRAY 4 OF INTEGER32; END;
    AutomationEventList = RECORD Capacity, Count: CARDINAL32; Events: POINTER TO AutomationEvent; END;
    LoadFileDataCallback = PROCEDURE(FileName: CSTRING; DataSize: POINTER TO INTEGER32): POINTER TO BYTE;
    SaveFileDataCallback = PROCEDURE(FileName: CSTRING; Data: ADDRESS; DataSize: INTEGER32): BOOLEAN;
    LoadFileTextCallback = PROCEDURE(FileName: CSTRING): CSTRING;
    SaveFileTextCallback = PROCEDURE(FileName, Text: CSTRING): BOOLEAN;
    AudioCallback = PROCEDURE(BufferData: ADDRESS; Frames: CARDINAL32);

CONST
    FLAG_VSYNC_HINT = 64;
    FLAG_FULLSCREEN_MODE = 2;
    FLAG_WINDOW_RESIZABLE = 4;
    FLAG_WINDOW_UNDECORATED = 8;
    FLAG_WINDOW_HIDDEN = 128;
    FLAG_WINDOW_MINIMIZED = 512;
    FLAG_WINDOW_MAXIMIZED = 1024;
    FLAG_WINDOW_UNFOCUSED = 2048;
    FLAG_WINDOW_TOPMOST = 4096;
    FLAG_WINDOW_ALWAYS_RUN = 256;
    FLAG_WINDOW_TRANSPARENT = 16;
    FLAG_WINDOW_HIGHDPI = 8192;
    FLAG_WINDOW_MOUSE_PASSTHROUGH = 16384;
    FLAG_BORDERLESS_WINDOWED_MODE = 32768;
    FLAG_MSAA_4X_HINT = 32;
    LOG_ALL = 0; LOG_TRACE = 1; LOG_DEBUG = 2; LOG_INFO = 3; LOG_WARNING = 4; LOG_ERROR = 5; LOG_FATAL = 6; LOG_NONE = 7;
    KEY_NULL = 0; KEY_SPACE = 32; KEY_ESCAPE = 256; KEY_ENTER = 257; KEY_TAB = 258; KEY_BACKSPACE = 259;
    KEY_RIGHT = 262; KEY_LEFT = 263; KEY_DOWN = 264; KEY_UP = 265; KEY_PAGE_UP = 266; KEY_PAGE_DOWN = 267;
    KEY_HOME = 268; KEY_END = 269; KEY_INSERT = 260; KEY_DELETE = 261;
    KEY_F1 = 290; KEY_F2 = 291; KEY_F3 = 292; KEY_F4 = 293; KEY_F5 = 294; KEY_F6 = 295; KEY_F7 = 296; KEY_F8 = 297; KEY_F9 = 298; KEY_F10 = 299; KEY_F11 = 300; KEY_F12 = 301;
    MOUSE_BUTTON_LEFT = 0; MOUSE_BUTTON_RIGHT = 1; MOUSE_BUTTON_MIDDLE = 2;
    CAMERA_CUSTOM = 0; CAMERA_FREE = 1; CAMERA_ORBITAL = 2; CAMERA_FIRST_PERSON = 3; CAMERA_THIRD_PERSON = 4;
    CAMERA_PERSPECTIVE = 0; CAMERA_ORTHOGRAPHIC = 1;
    BLEND_ALPHA = 0; BLEND_ADDITIVE = 1; BLEND_MULTIPLIED = 2; BLEND_ADD_COLORS = 3; BLEND_SUBTRACT_COLORS = 4; BLEND_ALPHA_PREMULTIPLY = 5; BLEND_CUSTOM = 6;
    PIXELFORMAT_UNCOMPRESSED_GRAYSCALE = 1; PIXELFORMAT_UNCOMPRESSED_GRAY_ALPHA = 2; PIXELFORMAT_UNCOMPRESSED_R5G6B5 = 3; PIXELFORMAT_UNCOMPRESSED_R8G8B8 = 4; PIXELFORMAT_UNCOMPRESSED_R5G5B5A1 = 5; PIXELFORMAT_UNCOMPRESSED_R4G4B4A4 = 6; PIXELFORMAT_UNCOMPRESSED_R8G8B8A8 = 7; PIXELFORMAT_UNCOMPRESSED_R32 = 8; PIXELFORMAT_UNCOMPRESSED_R32G32B32 = 9; PIXELFORMAT_UNCOMPRESSED_R32G32B32A32 = 10;

