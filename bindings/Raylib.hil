(* C has compound literals for these. Hilbert deliberately does not grow a
   pile of syntax just to make a vector, so keep the boring helpers here. *)
PROCEDURE MakeVector2(X, Y: REAL32): Vector2;
VAR V: Vector2;
BEGIN V.X := X; V.Y := Y; RETURN V END MakeVector2;

PROCEDURE MakeVector3(X, Y, Z: REAL32): Vector3;
VAR V: Vector3;
BEGIN V.X := X; V.Y := Y; V.Z := Z; RETURN V END MakeVector3;

PROCEDURE MakeRectangle(X, Y, Width, Height: REAL32): Rectangle;
VAR R: Rectangle;
BEGIN R.X := X; R.Y := Y; R.Width := Width; R.Height := Height; RETURN R END MakeRectangle;

PROCEDURE MakeColor(Red, Green, Blue, Alpha: BYTE): Color;
VAR C: Color;
BEGIN C.R := Red; C.G := Green; C.B := Blue; C.A := Alpha; RETURN C END MakeColor;
END Raylib.
