MODULE PCRE2;
(* First-party PCRE2 8-bit C ABI binding. *)
EXPORT Code, MatchData, CompileContext, MatchContext, GeneralContext, PCRE2_ZERO_TERMINATED, pcre2_compile_8, pcre2_code_free_8, pcre2_match_data_create_from_pattern_8, pcre2_match_data_create_8, pcre2_match_data_free_8, pcre2_match_8, pcre2_jit_match_8, pcre2_jit_compile_8, pcre2_get_ovector_pointer_8, pcre2_get_ovector_count_8;
EXPORT pcre2_get_error_message_8, pcre2_pattern_info_8, pcre2_substring_get_bynumber_8, pcre2_substring_free_8, pcre2_match_context_create_8, pcre2_match_context_free_8, pcre2_set_match_limit_8;

FOREIGN "C" LIBRARY "pcre2-8";

TYPE
    Code = ADDRESS;
    MatchData = ADDRESS;
    CompileContext = ADDRESS;
    MatchContext = ADDRESS;
    GeneralContext = ADDRESS;

CONST
    PCRE2_ZERO_TERMINATED = 18446744073709551615;

FOREIGN "C" PROCEDURE pcre2_compile_8(Pattern: POINTER TO BYTE; Length: SIZE; Options: CARDINAL32; ErrorCode: POINTER TO INTEGER32; ErrorOffset: POINTER TO SIZE; Context: CompileContext): Code;
FOREIGN "C" PROCEDURE pcre2_code_free_8(CodeData: Code);
FOREIGN "C" PROCEDURE pcre2_match_data_create_from_pattern_8(CodeData: Code; Context: GeneralContext): MatchData;
FOREIGN "C" PROCEDURE pcre2_match_data_create_8(OvecSize: CARDINAL32; Context: GeneralContext): MatchData;
FOREIGN "C" PROCEDURE pcre2_match_data_free_8(Data: MatchData);
FOREIGN "C" PROCEDURE pcre2_match_8(CodeData: Code; Subject: POINTER TO BYTE; Length, StartOffset: SIZE; Options: CARDINAL32; Data: MatchData; Context: MatchContext): INTEGER32;
FOREIGN "C" PROCEDURE pcre2_jit_match_8(CodeData: Code; Subject: POINTER TO BYTE; Length, StartOffset: SIZE; Options: CARDINAL32; Data: MatchData; Context: MatchContext): INTEGER32;
FOREIGN "C" PROCEDURE pcre2_jit_compile_8(CodeData: Code; Options: CARDINAL32): INTEGER32;
FOREIGN "C" PROCEDURE pcre2_get_ovector_pointer_8(Data: MatchData): POINTER TO SIZE;
FOREIGN "C" PROCEDURE pcre2_get_ovector_count_8(Data: MatchData): CARDINAL32;
FOREIGN "C" PROCEDURE pcre2_get_error_message_8(ErrorCode: INTEGER32; Buffer: POINTER TO BYTE; BufferSize: SIZE): INTEGER32;
FOREIGN "C" PROCEDURE pcre2_pattern_info_8(CodeData: Code; What: CARDINAL32; Where: ADDRESS): INTEGER32;
FOREIGN "C" PROCEDURE pcre2_substring_get_bynumber_8(Data: MatchData; Number: CARDINAL32; Buffer: POINTER TO ADDRESS; Length: POINTER TO SIZE): INTEGER32;
FOREIGN "C" PROCEDURE pcre2_substring_free_8(Buffer: ADDRESS);
FOREIGN "C" PROCEDURE pcre2_match_context_create_8(Context: GeneralContext): MatchContext;
FOREIGN "C" PROCEDURE pcre2_match_context_free_8(Context: MatchContext);
FOREIGN "C" PROCEDURE pcre2_set_match_limit_8(Context: MatchContext; Value: CARDINAL32): INTEGER32;

END PCRE2.
