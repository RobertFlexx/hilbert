IMPLEMENTATION MODULE Tokens;
FROM HStrings IMPORT Text, Assign;

PROCEDURE FromOrdinal(Value: LONGINT): TokenKind;
BEGIN
    RETURN VAL(TokenKind, Value)
END FromOrdinal;

PROCEDURE IsComparison(K: TokenKind): BOOLEAN;
BEGIN
    RETURN (K=TkEqual) OR (K=TkNotEqual) OR (K=TkLess) OR
           (K=TkLessEqual) OR (K=TkGreater) OR (K=TkGreaterEqual) OR
           (K=KwIN) OR (K=KwIS)
END IsComparison;
PROCEDURE KindName(K: TokenKind; VAR Out: Text);
BEGIN
    CASE K OF
    | TkEOF: Assign(Out,'end of file')
    | TkIdentifier: Assign(Out,'identifier')
    | TkInteger: Assign(Out,'integer')
    | TkReal: Assign(Out,'real')
    | TkString: Assign(Out,'string')
    | TkChar: Assign(Out,'character')
    | TkPlus: Assign(Out,'+')
    | TkMinus: Assign(Out,'-')
    | TkStar: Assign(Out,'*')
    | TkSlash: Assign(Out,'/')
    | TkEqual: Assign(Out,'=')
    | TkNotEqual: Assign(Out,'#')
    | TkLess: Assign(Out,'<')
    | TkLessEqual: Assign(Out,'<=')
    | TkGreater: Assign(Out,'>')
    | TkGreaterEqual: Assign(Out,'>=')
    | TkAssign: Assign(Out,':=')
    | TkColon: Assign(Out,':')
    | TkSemicolon: Assign(Out,';')
    | TkComma: Assign(Out,',')
    | TkDot: Assign(Out,'.')
    | TkRange: Assign(Out,'..')
    | TkLParen: Assign(Out,'(')
    | TkRParen: Assign(Out,')')
    | TkLBracket: Assign(Out,'[')
    | TkRBracket: Assign(Out,']')
    | TkLBrace: Assign(Out,'{')
    | TkRBrace: Assign(Out,'}')
    | TkArrow: Assign(Out,'->')
    | TkFatArrow: Assign(Out,'=>')
    | TkBar: Assign(Out,'|')
    | TkApostrophe: Assign(Out,"'")
    | TkCaret: Assign(Out,'^')
    | KwMODULE: Assign(Out,'MODULE')
    | KwDEFINITION: Assign(Out,'DEFINITION')
    | KwIMPORT: Assign(Out,'IMPORT')
    | KwFROM: Assign(Out,'FROM')
    | KwEXPORT: Assign(Out,'EXPORT')
    | KwCONST: Assign(Out,'CONST')
    | KwTYPE: Assign(Out,'TYPE')
    | KwSUBTYPE: Assign(Out,'SUBTYPE')
    | KwVAR: Assign(Out,'VAR')
    | KwPROCEDURE: Assign(Out,'PROCEDURE')
    | KwBEGIN: Assign(Out,'BEGIN')
    | KwEND: Assign(Out,'END')
    | KwRETURN: Assign(Out,'RETURN')
    | KwIF: Assign(Out,'IF')
    | KwTHEN: Assign(Out,'THEN')
    | KwELSIF: Assign(Out,'ELSIF')
    | KwELSE: Assign(Out,'ELSE')
    | KwCASE: Assign(Out,'CASE')
    | KwOF: Assign(Out,'OF')
    | KwWHILE: Assign(Out,'WHILE')
    | KwDO: Assign(Out,'DO')
    | KwFOR: Assign(Out,'FOR')
    | KwTO: Assign(Out,'TO')
    | KwBY: Assign(Out,'BY')
    | KwIN: Assign(Out,'IN')
    | KwLOOP: Assign(Out,'LOOP')
    | KwEXIT: Assign(Out,'EXIT')
    | KwRECORD: Assign(Out,'RECORD')
    | KwARRAY: Assign(Out,'ARRAY')
    | KwSLICE: Assign(Out,'SLICE')
    | KwSET: Assign(Out,'SET')
    | KwPOINTER: Assign(Out,'POINTER')
    | KwREF: Assign(Out,'REF')
    | KwDISTINCT: Assign(Out,'DISTINCT')
    | KwRANGE: Assign(Out,'RANGE')
    | KwTRUE: Assign(Out,'TRUE')
    | KwFALSE: Assign(Out,'FALSE')
    | KwNIL: Assign(Out,'NIL')
    | KwAND: Assign(Out,'AND')
    | KwOR: Assign(Out,'OR')
    | KwXOR: Assign(Out,'XOR')
    | KwNOT: Assign(Out,'NOT')
    | KwDIV: Assign(Out,'DIV')
    | KwMOD: Assign(Out,'MOD')
    | KwSHL: Assign(Out,'SHL')
    | KwSHR: Assign(Out,'SHR')
    | KwPRE: Assign(Out,'PRE')
    | KwPOST: Assign(Out,'POST')
    | KwASSERT: Assign(Out,'ASSERT')
    | KwINVARIANT: Assign(Out,'INVARIANT')
    | KwTASK: Assign(Out,'TASK')
    | KwSTART: Assign(Out,'START')
    | KwAWAIT: Assign(Out,'AWAIT')
    | KwPARALLEL: Assign(Out,'PARALLEL')
    | KwPROTECTED: Assign(Out,'PROTECTED')
    | KwATOMIC: Assign(Out,'ATOMIC')
    | KwUNSAFE: Assign(Out,'UNSAFE')
    | KwFOREIGN: Assign(Out,'FOREIGN')
    | KwEXTERNAL: Assign(Out,'EXTERNAL')
    | KwNAME: Assign(Out,'NAME')
    | KwLIBRARY: Assign(Out,'LIBRARY')
    | KwVARARGS: Assign(Out,'VARARGS')
    | KwEXCEPTION: Assign(Out,'EXCEPTION')
    | KwRAISE: Assign(Out,'RAISE')
    | KwEXCEPT: Assign(Out,'EXCEPT')
    | KwGENERIC: Assign(Out,'GENERIC')
    | KwWHERE: Assign(Out,'WHERE')
    | KwIS: Assign(Out,'IS')
    | KwABSTRACT: Assign(Out,'ABSTRACT')
    | KwPRIVATE: Assign(Out,'PRIVATE')
    | KwNEW: Assign(Out,'NEW')
    | KwWITH: Assign(Out,'WITH')
    | KwDEFER: Assign(Out,'DEFER')
    | KwREPEAT: Assign(Out,'REPEAT')
    | KwUNTIL: Assign(Out,'UNTIL')
    | KwSIZEOF: Assign(Out,'SIZEOF')
    | KwALIGNOF: Assign(Out,'ALIGNOF')
    | KwADR: Assign(Out,'ADR')
    | KwDIVISION: Assign(Out,'DIVISION')
    | KwWHEN: Assign(Out,'WHEN')
    ELSE Assign(Out,'token')
    END
END KindName;
END Tokens.
