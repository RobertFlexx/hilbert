IMPLEMENTATION MODULE ErrorCodes;

FROM HStrings IMPORT Text,Assign;

PROCEDURE DefaultMessage(Code:CARDINAL; VAR Out:Text);
BEGIN
    CASE Code OF
    | EUnexpectedToken:Assign(Out,'unexpected token')
    | EExpectedIdentifier:Assign(Out,'expected identifier')
    | EInvalidCharacter:Assign(Out,'invalid character in source')
    | EUnterminatedComment:Assign(Out,'unterminated comment')
    | EUnterminatedLiteral:Assign(Out,'unterminated literal')
    | EInvalidNumber:Assign(Out,'invalid numeric literal')
    | EExpectedModule:Assign(Out,'expected MODULE declaration')
    | EModuleEndMismatch:Assign(Out,'module end name does not match its declaration')
    | EDeclarationExpected:Assign(Out,'expected declaration')
    | EStatementExpected:Assign(Out,'expected statement')
    | ETypeExpected:Assign(Out,'expected type')
    | EExpressionExpected:Assign(Out,'expected expression')
    | EExpectedSemicolon:Assign(Out,'expected semicolon')
    | EExpectedRightParen:Assign(Out,'expected right parenthesis')
    | EExpectedRightBracket:Assign(Out,'expected right bracket')
    | EExpectedEnd:Assign(Out,'expected END')
    | EProcedureEndMismatch:Assign(Out,'procedure end name does not match its declaration')
    | ETokenTooLong:Assign(Out,'token text exceeds compiler limit')
    | EDuplicateDeclaration:Assign(Out,'name is already declared in this scope')
    | EUnknownIdentifier:Assign(Out,'unknown identifier')
    | EUnknownType:Assign(Out,'unknown type')
    | EUnknownModule:Assign(Out,'unknown module')
    | EPrivateMember:Assign(Out,'module member is not exported')
    | EUnknownField:Assign(Out,'record has no field with this name')
    | ENotProcedure:Assign(Out,'called expression is not a procedure')
    | EWrongArgumentCount:Assign(Out,'wrong number of procedure arguments')
    | EArgumentType:Assign(Out,'procedure argument has the wrong type')
    | EAssignmentType:Assign(Out,'assignment types do not match')
    | EReturnType:Assign(Out,'returned value has the wrong type')
    | EReturnValueRequired:Assign(Out,'this procedure must return a value')
    | EVoidReturnValue:Assign(Out,'a value cannot be returned from this procedure')
    | EConditionBoolean:Assign(Out,'condition must have type BOOLEAN')
    | EAssertBoolean:Assign(Out,'ASSERT expects BOOLEAN')
    | EIndexInteger:Assign(Out,'index must have an integer type')
    | ENotIndexable:Assign(Out,'expression cannot be indexed')
    | EDerefType:Assign(Out,'^ expects POINTER or REF')
    | ENotAssignable:Assign(Out,'left side is not assignable')
    | EIncompatibleOperands:Assign(Out,'operands have incompatible types')
    | EBitwiseInteger:Assign(Out,'bit operation expects integer operands')
    | ERangeBounds:Assign(Out,'value is outside the declared range')
    | EBadRecordBase:Assign(Out,'record extension base must be a record')
    | ERecursiveValueType:Assign(Out,'type contains itself by value')
    | EDistinctConversion:Assign(Out,'invalid conversion to or from a distinct type')
    | EGenericConstraint:Assign(Out,'generic argument does not satisfy its constraint')
    | EGenericArity:Assign(Out,'wrong number of generic arguments')
    | ETypeConversionArity:Assign(Out,'type conversion requires exactly one value')
    | EIntrinsicArity:Assign(Out,'intrinsic called with the wrong number of arguments')
    | EInvalidTypeExpression:Assign(Out,'invalid type expression')
    | EReceiverType:Assign(Out,'invalid receiver type')
    | EExportMissing:Assign(Out,'exported name is not declared')
    | EBorrowAlias:Assign(Out,'exclusive VAR borrows alias the same storage')
    | EEscapingBorrow:Assign(Out,'borrowed local address escapes its lifetime')
    | EUnsafePointerAccess:Assign(Out,'raw pointer access requires UNSAFE')
    | EManagedRawConversion:Assign(Out,'raw address cannot implicitly become a managed reference')
    | EReservedFeature:Assign(Out,'reserved for a later language revision')
    | EConstantExpression:Assign(Out,'CONST initializer is not a constant expression')
    | EDivisionCondition:Assign(Out,'invalid DIVISION condition')
    | EDivisionEndMismatch:Assign(Out,'division end name does not match its declaration')
    | EDivisionVisibility:Assign(Out,'invalid DIVISION visibility')
    | EAddressableRequired:Assign(Out,'expression is not addressable')
    | EExitOutsideLoop:Assign(Out,'EXIT is only valid inside a loop')
    | EForIterator:Assign(Out,'invalid FOR iterator or bound')
    | EDeferLowering:Assign(Out,'cannot lower DEFER statement')
    | EParallelLowering:Assign(Out,'cannot lower PARALLEL statement')
    | EExceptionLowering:Assign(Out,'cannot lower exception operation')
    | ETaskLowering:Assign(Out,'cannot lower task operation')
    | EAtomicCASLowering:Assign(Out,'cannot lower atomic compare-and-swap')
    | ETooManyCallArgs:Assign(Out,'call has too many arguments for the backend')
    | EUnsupportedABIArg:Assign(Out,'procedure argument is unsupported by the native ABI path')
    | EUnsupportedABIReturn:Assign(Out,'procedure result is unsupported by the native ABI path')
    | EHirMalformed:Assign(Out,'typed HIR is malformed')
    | EBackendUnsupportedType:Assign(Out,'type is unsupported by the native backend')
    | EBackendUnsupportedOp:Assign(Out,'operation is unsupported by the native backend')
    | EStackFrameTooLarge:Assign(Out,'procedure stack frame is too large')
    | ERelocationUnsupported:Assign(Out,'object relocation is unsupported')
    | ESourceOpen:Assign(Out,'cannot open source file')
    | ESourceTooLarge:Assign(Out,'source file exceeds compiler limit')
    | EModuleNotFound:Assign(Out,'imported module was not found')
    | ECircularImport:Assign(Out,'circular module import detected')
    | EModuleGraphLimit:Assign(Out,'module graph exceeds compiler limit')
    | EImportLimit:Assign(Out,'module import count exceeds compiler limit')
    | EForeignLibraryLimit:Assign(Out,'foreign library count exceeds compiler limit')
    | EModuleChanged:Assign(Out,'module changed while it was being compiled')
    | EOutputCreate:Assign(Out,'cannot create output file')
    | EUnknownTarget:Assign(Out,'unknown target triple')
    | EBackendTarget:Assign(Out,'native backend is not implemented for this target')
    | EAssemblerFailed:Assign(Out,'assembler failed')
    | ELinkerFailed:Assign(Out,'linker failed')
    | EBuildDirectory:Assign(Out,'cannot create build directory')
    | EStaticLinkFailed:Assign(Out,'static link failed')
    | EObjectWrite:Assign(Out,'cannot write native object')
    | ERuntimeBuild:Assign(Out,'Hilbert runtime compilation failed')
    | ECommandTooLong:Assign(Out,'generated native command exceeds compiler limit')
    | EOptionUnknown:Assign(Out,'unknown command-line option')
    | EOptionValue:Assign(Out,'invalid command-line option value')
    | EMissingInput:Assign(Out,'missing input file')
    | ETooManySearchPaths:Assign(Out,'too many module or library search paths')
    | ETooManyLibraries:Assign(Out,'too many native libraries')
    | EArgumentTooLong:Assign(Out,'command-line argument exceeds tool limit')
    | EProjectOpen:Assign(Out,'cannot open Hilbertfile')
    | EProjectSyntax:Assign(Out,'invalid Hilbertfile syntax')
    | EProjectMissingRoot:Assign(Out,'project has no ROOT entry')
    | EProjectUnknownKey:Assign(Out,'unknown Hilbertfile setting')
    | EProjectBuildFailed:Assign(Out,'project build failed')
    | EProjectCycle:Assign(Out,'project dependency cycle detected')
    | EArenaAST:Assign(Out,'AST arena exhausted')
    | EArenaHIR:Assign(Out,'HIR arena exhausted')
    | EArenaTypes:Assign(Out,'type arena exhausted')
    | EArenaSymbols:Assign(Out,'symbol arena exhausted')
    | EArenaScopes:Assign(Out,'scope arena exhausted')
    | EArenaLayout:Assign(Out,'layout arena exhausted')
    | EArenaSignatures:Assign(Out,'signature arena exhausted')
    | EArenaInterfaces:Assign(Out,'interface arena exhausted')
    | EInternalInvariant:Assign(Out,'internal compiler invariant failed')
    | EInternal:Assign(Out,'internal compiler error')
    | WUnusedImport:Assign(Out,'imported module is not used')
    | WUnusedLocal:Assign(Out,'local declaration is not used')
    | WShadowedName:Assign(Out,'declaration shadows an outer name')
    | WImplicitNumericConversion:Assign(Out,'implicit numeric conversion')
    | WDeprecated:Assign(Out,'deprecated language feature')
    | WUnreachable:Assign(Out,'statement is unreachable')
    | WEmptyBody:Assign(Out,'declaration has an empty body')
    | WForeignUnsafe:Assign(Out,'foreign operation crosses the safe language boundary')
    | WRangeCheckElided:Assign(Out,'range check was proven unnecessary')
    | WRawAddress:Assign(Out,'raw address operation requires care')
    | WGCConservativeRoot:Assign(Out,'conservative GC root may retain an object')
    ELSE Assign(Out,'compiler diagnostic')
    END
END DefaultMessage;

END ErrorCodes.
