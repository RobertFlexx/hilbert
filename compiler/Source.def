DEFINITION MODULE Source;

FROM HStrings IMPORT Text;

CONST MaxSource = 8388607;
TYPE SourceId = CARDINAL;

PROCEDURE Load(Path: ARRAY OF CHAR): BOOLEAN;
PROCEDURE Length(): CARDINAL;
PROCEDURE CharAt(Pos: CARDINAL): CHAR;
PROCEDURE FileName(VAR Out: Text);
PROCEDURE LineText(LineNo:CARDINAL; VAR Out:Text);

END Source.
