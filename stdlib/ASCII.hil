MODULE ASCII;
EXPORT IsASCII, IsDigit, IsHexDigit, IsUpper, IsLower, IsAlpha, IsAlnum, IsSpace, IsPrintable, ToUpper, ToLower;

PROCEDURE IsASCII(C: CHAR): BOOLEAN; BEGIN RETURN ORD(C) < 128 END IsASCII;
PROCEDURE IsDigit(C: CHAR): BOOLEAN; BEGIN RETURN (C >= '0') AND (C <= '9') END IsDigit;
PROCEDURE IsUpper(C: CHAR): BOOLEAN; BEGIN RETURN (C >= 'A') AND (C <= 'Z') END IsUpper;
PROCEDURE IsLower(C: CHAR): BOOLEAN; BEGIN RETURN (C >= 'a') AND (C <= 'z') END IsLower;
PROCEDURE IsAlpha(C: CHAR): BOOLEAN; BEGIN RETURN IsUpper(C) OR IsLower(C) END IsAlpha;
PROCEDURE IsAlnum(C: CHAR): BOOLEAN; BEGIN RETURN IsAlpha(C) OR IsDigit(C) END IsAlnum;
PROCEDURE IsHexDigit(C: CHAR): BOOLEAN; BEGIN RETURN IsDigit(C) OR ((C >= 'A') AND (C <= 'F')) OR ((C >= 'a') AND (C <= 'f')) END IsHexDigit;
PROCEDURE IsSpace(C: CHAR): BOOLEAN; BEGIN RETURN (C = ' ') OR (ORD(C) = 9) OR (ORD(C) = 10) OR (ORD(C) = 13) END IsSpace;
PROCEDURE IsPrintable(C: CHAR): BOOLEAN; BEGIN RETURN (ORD(C) >= 32) AND (ORD(C) < 127) END IsPrintable;
PROCEDURE ToUpper(C: CHAR): CHAR; BEGIN IF IsLower(C) THEN RETURN CHR(ORD(C) - 32) END; RETURN C END ToUpper;
PROCEDURE ToLower(C: CHAR): CHAR; BEGIN IF IsUpper(C) THEN RETURN CHR(ORD(C) + 32) END; RETURN C END ToLower;
END ASCII.
