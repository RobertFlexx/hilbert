MODULE Strings;
EXPORT Length, Empty, Compare, Equal, StartsWith, EndsWith, Contains, Find, FindChar;

FOREIGN "C" PROCEDURE CStrLen(S: CSTRING): SIZE EXTERNAL NAME "strlen";
FOREIGN "C" PROCEDURE CStrCmp(A, B: CSTRING): INTEGER32 EXTERNAL NAME "strcmp";
FOREIGN "C" PROCEDURE CStrNCmp(A, B: CSTRING; N: SIZE): INTEGER32 EXTERNAL NAME "strncmp";
FOREIGN "C" PROCEDURE CStrStr(Haystack, Needle: CSTRING): CSTRING EXTERNAL NAME "strstr";
FOREIGN "C" PROCEDURE CStrChr(S: CSTRING; Ch: INTEGER32): CSTRING EXTERNAL NAME "strchr";

PROCEDURE Length(S: STRING): SIZE;
BEGIN IF S = NIL THEN RETURN 0 END; RETURN CStrLen(S) END Length;

PROCEDURE Empty(S: STRING): BOOLEAN;
BEGIN RETURN Length(S) = 0 END Empty;

PROCEDURE Compare(A, B: STRING): INTEGER32;
BEGIN
    IF A = NIL THEN IF B = NIL THEN RETURN 0 ELSE RETURN -1 END END;
    IF B = NIL THEN RETURN 1 END;
    RETURN CStrCmp(A, B)
END Compare;

PROCEDURE Equal(A, B: STRING): BOOLEAN;
BEGIN
    IF A = NIL THEN RETURN B = NIL END;
    IF B = NIL THEN RETURN FALSE END;
    RETURN CStrCmp(A, B) = 0
END Equal;

PROCEDURE StartsWith(S, Prefix: STRING): BOOLEAN;
VAR N: SIZE;
BEGIN
    N := Length(Prefix);
    IF N = 0 THEN RETURN TRUE END;
    IF S = NIL THEN RETURN FALSE END;
    RETURN CStrNCmp(S, Prefix, N) = 0
END StartsWith;

PROCEDURE EndsWith(S, Suffix: STRING): BOOLEAN;
VAR SL, TL, I: SIZE;
BEGIN
    SL := Length(S); TL := Length(Suffix);
    IF TL = 0 THEN RETURN TRUE END;
    IF (S = NIL) OR (TL > SL) THEN RETURN FALSE END;
    I := 0;
    WHILE I < TL DO
        IF S[SL - TL + I] # Suffix[I] THEN RETURN FALSE END;
        I := I + 1
    END;
    RETURN TRUE
END EndsWith;

PROCEDURE Contains(S, Part: STRING): BOOLEAN;
BEGIN
    IF Part = NIL THEN RETURN TRUE END;
    IF S = NIL THEN RETURN FALSE END;
    RETURN CStrStr(S, Part) # NIL
END Contains;

PROCEDURE Find(S, Part: STRING): CSTRING;
BEGIN IF (S = NIL) OR (Part = NIL) THEN RETURN NIL END; RETURN CStrStr(S, Part) END Find;

PROCEDURE FindChar(S: STRING; Ch: BYTE): CSTRING;
BEGIN IF S = NIL THEN RETURN NIL END; RETURN CStrChr(S, INTEGER32(Ch)) END FindChar;

END Strings.
