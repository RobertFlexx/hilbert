MODULE EndianIO;
EXPORT Swap16, Swap32, Swap64;
PROCEDURE Swap16(X: CARDINAL16): CARDINAL16;
BEGIN RETURN (X SHL 8) OR (X SHR 8) END Swap16;
PROCEDURE Swap32(X: CARDINAL32): CARDINAL32;
BEGIN RETURN ((X AND 255) SHL 24) OR ((X AND 65280) SHL 8) OR ((X SHR 8) AND 65280) OR ((X SHR 24) AND 255) END Swap32;
PROCEDURE Swap64(X: CARDINAL64): CARDINAL64;
BEGIN
    RETURN ((X AND 255) SHL 56) OR ((X AND 65280) SHL 40) OR ((X AND 16711680) SHL 24) OR ((X AND 4278190080) SHL 8) OR ((X SHR 8) AND 4278190080) OR ((X SHR 24) AND 16711680) OR ((X SHR 40) AND 65280) OR ((X SHR 56) AND 255)
END Swap64;
END EndianIO.
