MODULE Environment;
EXPORT Get, Has, Set, Unset, Home, User, Path, Shell, Temp, Language;
FOREIGN "C" PROCEDURE getenv(Name: CSTRING): CSTRING;
FOREIGN "C" PROCEDURE setenv(Name, Value: CSTRING; Overwrite: INTEGER32): INTEGER32;
FOREIGN "C" PROCEDURE unsetenv(Name: CSTRING): INTEGER32;
PROCEDURE Get(Name: CSTRING): CSTRING; BEGIN IF Name = NIL THEN RETURN NIL END; RETURN getenv(Name) END Get;
PROCEDURE Has(Name:CSTRING):BOOLEAN; BEGIN RETURN Get(Name) # NIL END Has;
PROCEDURE Set(Name,Value:CSTRING;Overwrite:BOOLEAN):BOOLEAN; BEGIN IF (Name = NIL) OR (Value = NIL) THEN RETURN FALSE END; IF Overwrite THEN RETURN setenv(Name,Value,1)=0 ELSE RETURN setenv(Name,Value,0)=0 END END Set;
PROCEDURE Unset(Name:CSTRING):BOOLEAN; BEGIN RETURN (Name # NIL) AND (unsetenv(Name)=0) END Unset;
PROCEDURE Home():CSTRING; BEGIN RETURN getenv("HOME") END Home;
PROCEDURE User():CSTRING; BEGIN RETURN getenv("USER") END User;
PROCEDURE Path():CSTRING; BEGIN RETURN getenv("PATH") END Path;
PROCEDURE Shell():CSTRING; BEGIN RETURN getenv("SHELL") END Shell;
PROCEDURE Temp():CSTRING; VAR V:CSTRING; BEGIN V:=getenv("TMPDIR"); IF V=NIL THEN RETURN "/tmp" END; RETURN V END Temp;
PROCEDURE Language():CSTRING; VAR V:CSTRING; BEGIN V:=getenv("LC_ALL"); IF V#NIL THEN RETURN V END; V:=getenv("LC_MESSAGES"); IF V#NIL THEN RETURN V END; RETURN getenv("LANG") END Language;
END Environment.
