MODULE Checksums;
EXPORT FNV1a32, FNV1a64, Adler32;

PROCEDURE FNV1a32(Data: POINTER TO BYTE; Length: SIZE): CARDINAL32;
VAR I: SIZE; H: CARDINAL32;
BEGIN
    H := 2166136261; I := 0;
    UNSAFE BEGIN WHILE I < Length DO H := (H XOR Data[I]) * 16777619; I := I + 1 END END;
    RETURN H
END FNV1a32;

PROCEDURE FNV1a64(Data: POINTER TO BYTE; Length: SIZE): CARDINAL64;
VAR I: SIZE; H: CARDINAL64;
BEGIN
    H := 14695981039346656037; I := 0;
    UNSAFE BEGIN WHILE I < Length DO H := (H XOR Data[I]) * 1099511628211; I := I + 1 END END;
    RETURN H
END FNV1a64;

PROCEDURE Adler32(Data: POINTER TO BYTE; Length: SIZE): CARDINAL32;
VAR I: SIZE; A, B: CARDINAL32;
BEGIN
    I := 0; A := 1; B := 0;
    UNSAFE BEGIN
        WHILE I < Length DO A := (A + Data[I]) MOD 65521; B := (B + A) MOD 65521; I := I + 1 END
    END;
    RETURN (B SHL 16) OR A
END Adler32;

END Checksums.
