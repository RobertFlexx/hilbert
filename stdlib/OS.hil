MODULE OS;
EXPORT PageSize, ProcessId, HostName;
FOREIGN "C" PROCEDURE CGetPid(): INTEGER EXTERNAL NAME "getpid";
FOREIGN "C" PROCEDURE CGetPageSize(): INTEGER EXTERNAL NAME "getpagesize";
FOREIGN "C" PROCEDURE CGetHostName(Buffer:CSTRING; Size:SIZE):INTEGER32 EXTERNAL NAME "gethostname";
PROCEDURE PageSize(): INTEGER; BEGIN RETURN CGetPageSize() END PageSize;
PROCEDURE ProcessId(): INTEGER; BEGIN RETURN CGetPid() END ProcessId;
PROCEDURE HostName(Buffer:CSTRING;Size:SIZE):BOOLEAN; BEGIN RETURN (Buffer#NIL) AND (Size#0) AND (CGetHostName(Buffer,Size)=0) END HostName;
END OS.
