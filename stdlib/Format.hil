MODULE Format;
EXPORT Print, PrintFd, PrintTo, VPrintTo;
FOREIGN "C" PROCEDURE Print(Format: CSTRING) VARARGS EXTERNAL NAME "printf";
FOREIGN "C" PROCEDURE PrintFd(Descriptor: INTEGER32; Format: CSTRING) VARARGS EXTERNAL NAME "dprintf";
FOREIGN "C" PROCEDURE PrintTo(Buffer: CSTRING; Size: SIZE; Format: CSTRING): INTEGER32 VARARGS EXTERNAL NAME "snprintf";
FOREIGN "C" PROCEDURE VPrintTo(Buffer: CSTRING; Size: SIZE; Format: CSTRING; Args: ADDRESS): INTEGER32 EXTERNAL NAME "vsnprintf";
END Format.
