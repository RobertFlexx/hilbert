MODULE Math;
EXPORT Pi, E, Abs, AbsInt, Min, Max, Clamp, Sqrt, Cbrt, Sin, Cos, Tan, ASin, ACos, ATan, ATan2, Exp, Log, Log10, Pow, Floor, Ceil, Round, Fmod, IsFinite, IsNaN;

CONST Pi = 3.14159265358979323846; E = 2.71828182845904523536;
FOREIGN "C" LIBRARY "m";
FOREIGN "C" PROCEDURE sqrt(X: REAL64): REAL64;
FOREIGN "C" PROCEDURE cbrt(X: REAL64): REAL64;
FOREIGN "C" PROCEDURE sin(X: REAL64): REAL64;
FOREIGN "C" PROCEDURE cos(X: REAL64): REAL64;
FOREIGN "C" PROCEDURE tan(X: REAL64): REAL64;
FOREIGN "C" PROCEDURE asin(X: REAL64): REAL64;
FOREIGN "C" PROCEDURE acos(X: REAL64): REAL64;
FOREIGN "C" PROCEDURE atan(X: REAL64): REAL64;
FOREIGN "C" PROCEDURE atan2(Y, X: REAL64): REAL64;
FOREIGN "C" PROCEDURE exp(X: REAL64): REAL64;
FOREIGN "C" PROCEDURE log(X: REAL64): REAL64;
FOREIGN "C" PROCEDURE log10(X: REAL64): REAL64;
FOREIGN "C" PROCEDURE pow(X, Y: REAL64): REAL64;
FOREIGN "C" PROCEDURE floor(X: REAL64): REAL64;
FOREIGN "C" PROCEDURE ceil(X: REAL64): REAL64;
FOREIGN "C" PROCEDURE round(X: REAL64): REAL64;
FOREIGN "C" PROCEDURE fmod(X, Y: REAL64): REAL64;
FOREIGN "C" PROCEDURE isfinite(X: REAL64): INTEGER32;
FOREIGN "C" PROCEDURE isnan(X: REAL64): INTEGER32;

PROCEDURE Abs(X: REAL64): REAL64; BEGIN IF X < 0.0 THEN RETURN -X END; RETURN X END Abs;
PROCEDURE AbsInt(X: INTEGER): INTEGER; BEGIN IF X < 0 THEN RETURN -X END; RETURN X END AbsInt;
PROCEDURE Min(A, B: REAL64): REAL64; BEGIN IF A < B THEN RETURN A END; RETURN B END Min;
PROCEDURE Max(A, B: REAL64): REAL64; BEGIN IF A > B THEN RETURN A END; RETURN B END Max;
PROCEDURE Clamp(X, Lo, Hi: REAL64): REAL64; BEGIN IF X < Lo THEN RETURN Lo ELSIF X > Hi THEN RETURN Hi END; RETURN X END Clamp;
PROCEDURE Sqrt(X: REAL64): REAL64; BEGIN RETURN sqrt(X) END Sqrt;
PROCEDURE Cbrt(X: REAL64): REAL64; BEGIN RETURN cbrt(X) END Cbrt;
PROCEDURE Sin(X: REAL64): REAL64; BEGIN RETURN sin(X) END Sin;
PROCEDURE Cos(X: REAL64): REAL64; BEGIN RETURN cos(X) END Cos;
PROCEDURE Tan(X: REAL64): REAL64; BEGIN RETURN tan(X) END Tan;
PROCEDURE ASin(X: REAL64): REAL64; BEGIN RETURN asin(X) END ASin;
PROCEDURE ACos(X: REAL64): REAL64; BEGIN RETURN acos(X) END ACos;
PROCEDURE ATan(X: REAL64): REAL64; BEGIN RETURN atan(X) END ATan;
PROCEDURE ATan2(Y, X: REAL64): REAL64; BEGIN RETURN atan2(Y, X) END ATan2;
PROCEDURE Exp(X: REAL64): REAL64; BEGIN RETURN exp(X) END Exp;
PROCEDURE Log(X: REAL64): REAL64; BEGIN RETURN log(X) END Log;
PROCEDURE Log10(X: REAL64): REAL64; BEGIN RETURN log10(X) END Log10;
PROCEDURE Pow(X, Y: REAL64): REAL64; BEGIN RETURN pow(X, Y) END Pow;
PROCEDURE Floor(X: REAL64): REAL64; BEGIN RETURN floor(X) END Floor;
PROCEDURE Ceil(X: REAL64): REAL64; BEGIN RETURN ceil(X) END Ceil;
PROCEDURE Round(X: REAL64): REAL64; BEGIN RETURN round(X) END Round;
PROCEDURE Fmod(X, Y: REAL64): REAL64; BEGIN RETURN fmod(X, Y) END Fmod;
PROCEDURE IsFinite(X: REAL64): BOOLEAN; BEGIN RETURN isfinite(X) # 0 END IsFinite;
PROCEDURE IsNaN(X: REAL64): BOOLEAN; BEGIN RETURN isnan(X) # 0 END IsNaN;
END Math.
