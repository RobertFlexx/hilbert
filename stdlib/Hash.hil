MODULE Hash;
EXPORT FNV1a32, FNV1a64, DJB2;

PROCEDURE FNV1a32(Data: SLICE OF BYTE): CARDINAL32;
VAR H: CARDINAL32; I: SIZE;
BEGIN
    H := 2166136261; I := 0;
    WHILE I < Data.Length DO H := (H XOR Data[I]) * 16777619; I := I + 1 END;
    RETURN H
END FNV1a32;

PROCEDURE FNV1a64(Data: SLICE OF BYTE): CARDINAL64;
VAR H: CARDINAL64; I: SIZE;
BEGIN
    H := 14695981039346656037; I := 0;
    WHILE I < Data.Length DO H := (H XOR Data[I]) * 1099511628211; I := I + 1 END;
    RETURN H
END FNV1a64;

PROCEDURE DJB2(Data: SLICE OF BYTE): CARDINAL64;
VAR H: CARDINAL64; I: SIZE;
BEGIN
    H := 5381; I := 0;
    WHILE I < Data.Length DO H := ((H SHL 5) + H) + Data[I]; I := I + 1 END;
    RETURN H
END DJB2;

END Hash.
