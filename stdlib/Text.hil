MODULE Text;
EXPORT View, Length, Compare, Equal, FindByte;
TYPE
    View = RECORD Data: CSTRING; Length: SIZE; END;
FOREIGN "C" PROCEDURE strlen(S: CSTRING): SIZE;
FOREIGN "C" PROCEDURE strcmp(A, B: CSTRING): INTEGER32;
FOREIGN "C" PROCEDURE strchr(S: CSTRING; Ch: INTEGER32): CSTRING;
PROCEDURE Length(S: CSTRING): SIZE; BEGIN RETURN strlen(S) END Length;
PROCEDURE Compare(A, B: CSTRING): INTEGER32; BEGIN RETURN strcmp(A, B) END Compare;
PROCEDURE Equal(A, B: CSTRING): BOOLEAN; BEGIN RETURN strcmp(A, B) = 0 END Equal;
PROCEDURE FindByte(S: CSTRING; Ch: BYTE): CSTRING; BEGIN RETURN strchr(S, Ch) END FindByte;
END Text.
