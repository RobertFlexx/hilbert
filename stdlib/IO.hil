MODULE IO;
EXPORT Write, WriteLn, WriteChar, WriteInt, WriteCard, WriteCard64, WriteReal,
       WriteBool, WriteHex, NewLine, Error, ErrorLn, ErrorChar, Flush, ReadChar;

FOREIGN "C" PROCEDURE CPrintfString(Fmt: CSTRING; Value: CSTRING): INTEGER32 EXTERNAL NAME "printf";
FOREIGN "C" PROCEDURE CPrintfInt(Fmt: CSTRING; Value: INTEGER): INTEGER32 EXTERNAL NAME "printf";
FOREIGN "C" PROCEDURE CPrintfCard(Fmt: CSTRING; Value: CARDINAL): INTEGER32 EXTERNAL NAME "printf";
FOREIGN "C" PROCEDURE CPrintfCard64(Fmt: CSTRING; Value: CARDINAL64): INTEGER32 EXTERNAL NAME "printf";
FOREIGN "C" PROCEDURE CPrintfReal(Fmt: CSTRING; Value: REAL64): INTEGER32 EXTERNAL NAME "printf";
FOREIGN "C" PROCEDURE CPrintfHex(Fmt: CSTRING; Value: CARDINAL64): INTEGER32 EXTERNAL NAME "printf";
FOREIGN "C" PROCEDURE CPuts(S: CSTRING): INTEGER32 EXTERNAL NAME "puts";
FOREIGN "C" PROCEDURE CPutChar(Ch: INTEGER32): INTEGER32 EXTERNAL NAME "putchar";
FOREIGN "C" PROCEDURE CFlush(Stream: ADDRESS): INTEGER32 EXTERNAL NAME "fflush";
FOREIGN "C" PROCEDURE CGetChar(): INTEGER32 EXTERNAL NAME "getchar";
FOREIGN "C" PROCEDURE CDPrintString(Fd: INTEGER32; Fmt, Value: CSTRING): INTEGER32 EXTERNAL NAME "dprintf";
FOREIGN "C" PROCEDURE CDPrintChar(Fd: INTEGER32; Fmt: CSTRING; Value: INTEGER32): INTEGER32 EXTERNAL NAME "dprintf";

PROCEDURE Write(S: CSTRING); BEGIN IF S # NIL THEN CPrintfString("%s", S) END END Write;
PROCEDURE WriteLn(S: CSTRING); BEGIN IF S = NIL THEN CPuts("") ELSE CPuts(S) END END WriteLn;
PROCEDURE WriteChar(Ch: CHAR); BEGIN CPutChar(ORD(Ch)) END WriteChar;
PROCEDURE WriteInt(N: INTEGER); BEGIN CPrintfInt("%ld", N) END WriteInt;
PROCEDURE WriteCard(N: CARDINAL); BEGIN CPrintfCard("%lu", N) END WriteCard;
PROCEDURE WriteCard64(N: CARDINAL64); BEGIN CPrintfCard64("%llu", N) END WriteCard64;
PROCEDURE WriteReal(X: REAL64); BEGIN CPrintfReal("%.17g", X) END WriteReal;
PROCEDURE WriteBool(B: BOOLEAN); BEGIN IF B THEN Write("TRUE") ELSE Write("FALSE") END END WriteBool;
PROCEDURE WriteHex(N: CARDINAL64); BEGIN CPrintfHex("0x%llx", N) END WriteHex;
PROCEDURE NewLine; BEGIN CPuts("") END NewLine;
PROCEDURE Error(S: CSTRING); BEGIN IF S # NIL THEN CDPrintString(2, "%s", S) END END Error;
PROCEDURE ErrorLn(S: CSTRING); BEGIN IF S = NIL THEN CDPrintString(2, "%s", "\n") ELSE CDPrintString(2, "%s\n", S) END END ErrorLn;
PROCEDURE ErrorChar(Ch: CHAR); BEGIN CDPrintChar(2, "%c", ORD(Ch)) END ErrorChar;
PROCEDURE Flush; BEGIN CFlush(NIL) END Flush;
PROCEDURE ReadChar(): INTEGER32; BEGIN RETURN CGetChar() END ReadChar;
END IO.
