MODULE ProcedureValuesExample;
IMPORT IO;

TYPE BinaryOperation = PROCEDURE(A, B: INTEGER): INTEGER;

PROCEDURE Add(A, B: INTEGER): INTEGER;
BEGIN RETURN A + B END Add;

PROCEDURE Multiply(A, B: INTEGER): INTEGER;
BEGIN RETURN A * B END Multiply;

PROCEDURE Apply(Operation: BinaryOperation; A, B: INTEGER): INTEGER;
BEGIN RETURN Operation(A, B) END Apply;

VAR Operation: BinaryOperation;

BEGIN
    Operation := Add;
    ASSERT Apply(Operation, 20, 22) = 42;
    Operation := Multiply;
    ASSERT Apply(Operation, 6, 7) = 42;
    IO.WriteLn("indirect calls passed")
END ProcedureValuesExample.
