MODULE StdlibGenerics;
IMPORT Algorithms;

TYPE Pair = RECORD Left, Right: INTEGER; END;
VAR A, B: INTEGER;
    P, Q: Pair;

BEGIN
    ASSERT Algorithms.Min[INTEGER](9, 4) = 4;
    ASSERT Algorithms.Max[REAL64](2.5, 7.5) = 7.5;
    ASSERT Algorithms.Clamp[CARDINAL32](90, 10, 50) = 50;
    A := 12; B := 30;
    Algorithms.Swap[INTEGER](A, B);
    ASSERT A = 30;
    ASSERT B = 12;
    P.Left := 20; P.Right := 22;
    Q.Left := 1; Q.Right := 2;
    Algorithms.Swap[Pair](P, Q);
    ASSERT Q.Left + Q.Right = 42
END StdlibGenerics.
