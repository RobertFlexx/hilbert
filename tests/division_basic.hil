MODULE DivisionBasic;

DIVISION platform WHEN TARGET("linux") AND ARCH("x86_64") AND HOSTED;
EXPORT Chosen;

CONST
  Secret = 41;

PROCEDURE Chosen(): INTEGER;
BEGIN
  RETURN Secret + 1
END Chosen;

END platform;

DIVISION spare WHEN FREESTANDING OR DEBUG;

PROCEDURE NotSelected(): INTEGER;
BEGIN
  RETURN 0
END NotSelected;

END spare;

BEGIN
  ASSERT(Chosen() = 42)
END DivisionBasic.
