MODULE ImportSurfaceDep;
EXPORT Number, Counter, Answer, Huge, Add, State, Ready, Busy;

TYPE Number = INTEGER32;
     State = (Ready, Busy);
CONST Answer = 42;
      Huge = 18446744073709551615;
VAR Counter: Number;

